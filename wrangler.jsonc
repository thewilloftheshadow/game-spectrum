{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "game-spectrum",
	"main": "./src/worker.ts",
	"account_id": "07c634e5b9f9eb260972946dc8e2f891",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": ["nodejs_compat"],
	// Check hourly; each linked account is eligible only after 48 hours.
	// A day-of-month */2 expression does not preserve 48-hour spacing across months.
	"triggers": { "crons": ["0 * * * *"] },
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "www.gamespectrum.org",
			"custom_domain": true
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://www.gamespectrum.org"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "game-spectrum",
			"database_id": "383eca4b-9e4a-461f-bc1e-2be50fa5d7b7",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "USER_UPLOADS",
			"bucket_name": "game-spectrum-user-uploads"
		}
	]
}
